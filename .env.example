# Настройки для сайта (раздел «Менеджмент»). Для запуска на своём компьютере файл .env не нужен.
PORT=3400
HOST=127.0.0.1
# Как DATABASE_URL в /home/ivanc1539/tea-market-v2/backend/.env — нужен для входа через «Менеджмент»
DATABASE_URL=
# Случайная строка: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
COOKIE_SECURE=1
COOKIE_PATH=/management/labels/
